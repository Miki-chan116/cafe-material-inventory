{
  "description": "Local safety experiment for this project only. Never use as the deployment gate.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/pre_tool_use.py",
            "timeout": 5,
            "statusMessage": "Checking project-local safety policy"
          }
        ]
      }
    ]
  }
}
